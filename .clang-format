---
# Amarian C++ formatting rules.
# Consensus-critical code is read far more often than it is written; the style
# optimises for reviewability and stable diffs.
Language: Cpp
BasedOnStyle: LLVM

Standard: c++20
ColumnLimit: 100
IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4
AccessModifierOffset: -4

AlignAfterOpenBracket: Align
AlignConsecutiveAssignments: false
AlignEscapedNewlines: Left
AlignOperands: Align
AlignTrailingComments: true

AllowShortBlocksOnASingleLine: Empty
AllowShortCaseLabelsOnASingleLine: false
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

AlwaysBreakTemplateDeclarations: Yes
BinPackArguments: false
BinPackParameters: false

BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: false
  AfterControlStatement: Never
  AfterEnum: false
  AfterFunction: false
  AfterNamespace: false
  AfterStruct: false
  AfterUnion: false
  BeforeCatch: false
  BeforeElse: false
  BeforeLambdaBody: false
  IndentBraces: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false

BreakConstructorInitializers: BeforeColon
BreakInheritanceList: BeforeColon
ConstructorInitializerIndentWidth: 4
Cpp11BracedListStyle: true

DerivePointerAlignment: false
PointerAlignment: Left
ReferenceAlignment: Left
QualifierAlignment: Left

EmptyLineBeforeAccessModifier: LogicalBlock
FixNamespaceComments: true
IndentCaseLabels: true
IndentPPDirectives: AfterHash
InsertNewlineAtEOF: true
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1
NamespaceIndentation: None

SeparateDefinitionBlocks: Always
SortIncludes: CaseSensitive
SortUsingDeclarations: true

# Preserve, not Regroup. Every source in this tree separates the header it implements
# from the headers it merely uses with a blank line, which is how a reader tells "this
# file's own interface" from "its dependencies" at a glance. Regroup merges the two
# because clang-format's main-include heuristic does not recognise an angle-bracketed
# own header, so it would delete that distinction from every file in the project and
# report the whole tree as misformatted. The categories below still order includes
# within each block, so grouping stays intentional and ordering stays mechanical.
IncludeBlocks: Preserve
IncludeCategories:
  # Own headers first so a header is self-contained or the build breaks.
  - Regex: '^<amarian/'
    Priority: 1
  # Third-party C libraries we bind to.
  - Regex: '^<(secp256k1|openssl|rocksdb|asio|nlohmann|gtest|gmock|benchmark)'
    Priority: 3
  # C++ standard library (single-word angle includes).
  - Regex: '^<[a-z_]+>$'
    Priority: 4
  # C standard library shims.
  - Regex: '^<c[a-z]+>$'
    Priority: 4
  - Regex: '^".*"$'
    Priority: 2
  - Regex: '.*'
    Priority: 5

SpaceAfterCStyleCast: false
SpaceAfterTemplateKeyword: false
SpaceBeforeParens: ControlStatements
SpacesBeforeTrailingComments: 2
