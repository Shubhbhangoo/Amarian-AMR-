# Build output
build/
out/
.cache/
compile_commands.json

# Local node data directories
.amarian/
data/
datadir*/
regtest-*/
testnet-*/
.tmp/
tmp/

# Fuzzing corpora & crash artifacts. Reproducible crashes get promoted into
# tests/vectors/ as explicit regression cases instead of living here.
fuzz/corpus/
fuzz/crashes/
fuzz/artifacts/

# libFuzzer writes its artifacts to the working directory, which is the repo root
# when a harness is run by hand. Three slow-unit files were already sitting there
# untracked, one `git add -A` away from being committed. Ignoring the prefixes is
# not a way to skip triage: scripts/time_slow_units.sh says whether a slow unit is
# real, and anything reproducible is promoted to tests/vectors/ before deletion.
slow-unit-*
crash-*
leak-*
timeout-*
oom-*
minimized-from-*

# Toolchain / editor noise
node_modules/
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
core
vgcore.*
perf.data*
callgrind.out.*

# Per-developer agent/tool state. Shared project rules belong in CLAUDE.md, which
# is tracked; local permission grants are machine-specific and are not.
.claude/settings.local.json

# Not ours. An empty "Program Files/ModifiableWindowsApps" tree dated 2025-12-13
# sits in the repo root, predating the project; it is an ACL-locked Windows reparse
# point that rmdir cannot touch. Git ignores empty directories, so it has never
# shown up in status — this line is here so it still cannot if something writes
# into it.
/Program Files/
