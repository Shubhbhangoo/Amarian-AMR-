{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
      }
    },
    {
      "name": "gcc",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "g++-15" }
    },
    {
      "name": "clang",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++-21" }
    },
    {
      "name": "dev",
      "displayName": "dev (gcc, RelWithDebInfo, tests)",
      "inherits": "gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "AMARIAN_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "debug (gcc, -O0 -g, tests)",
      "inherits": "gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AMARIAN_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "clang-dev",
      "displayName": "clang-dev (second compiler, catches GCC-specific luck)",
      "inherits": "clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "AMARIAN_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "asan+ubsan (clang)",
      "inherits": "clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "AMARIAN_BUILD_TESTS": "ON",
        "AMARIAN_SANITIZER": "address+undefined"
      }
    },
    {
      "name": "tsan",
      "displayName": "tsan (clang)",
      "inherits": "clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "AMARIAN_BUILD_TESTS": "ON",
        "AMARIAN_SANITIZER": "thread"
      }
    },
    {
      "name": "fuzz",
      "displayName": "libFuzzer + asan/ubsan (clang)",
      "inherits": "clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "AMARIAN_BUILD_TESTS": "OFF",
        "AMARIAN_BUILD_FUZZ": "ON",
        "AMARIAN_SANITIZER": "address+undefined"
      }
    },
    {
      "name": "bench",
      "displayName": "bench (gcc, Release)",
      "inherits": "gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AMARIAN_BUILD_TESTS": "OFF",
        "AMARIAN_BUILD_BENCH": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "release (gcc, Release, no tests)",
      "inherits": "gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AMARIAN_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "clang-dev", "configurePreset": "clang-dev" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "fuzz", "configurePreset": "fuzz" },
    { "name": "bench", "configurePreset": "bench" },
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
